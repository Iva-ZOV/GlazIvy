# Схема локального .env — БЕЗ значений (сам .env в .gitignore).
# Генерируется из %APPDATA%\GlazIvy\config.json:
#     .\.venv\Scripts\python.exe scripts\make_env.py
#
# Здесь живут все личные данные для прогонов: адреса камер, учётки, готовые
# RTSP-URL. В брифах и скриптах ссылаемся на ИМЕНА переменных, значения не
# копируем — так они лежат в одном месте и не расползаются по файлам.
#
# Имя переменной: GLAZIVY_<ИМЯ_КАМЕРЫ>_<ПАРАМЕТР>; одинаковые имена камер
# нумеруются (_1, _2).

GLAZIVY_<КАМЕРА>_HOST=
GLAZIVY_<КАМЕРА>_PORT=
GLAZIVY_<КАМЕРА>_USER=
GLAZIVY_<КАМЕРА>_PASSWORD=
GLAZIVY_<КАМЕРА>_ONVIF=
GLAZIVY_<КАМЕРА>_ONVIF_USER=
GLAZIVY_<КАМЕРА>_ONVIF_PASSWORD=
GLAZIVY_<КАМЕРА>_RTSP_SD=
GLAZIVY_<КАМЕРА>_RTSP_HD=
