# --- Сборка и окружение (не выкладываем, всё регенерируется) ---
.venv/
venv/
build/
dist/
release/
_probe/
_preview_dialogs/
*.spec.bak

# Сгенерированная иконка (создаётся scripts/generate_icon.py при сборке)
assets/app_icon.ico

# Модель детектора скачивается scripts/fetch_model.py перед запуском/сборкой.
/assets/models/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/

# --- Личное: настройки/данные камер сюда не должны попадать ---
# (обычно лежат в %APPDATA%\GlazIvy, но на всякий случай)
config.json
config.json.bak
# Личные данные для локальных прогонов (камеры, учётки). НИКОГДА не коммитить.
.env
*.env
!*.env.example
*.log

# --- Рабочие заметки/памятки с личными данными ---
ПАМЯТКА*.txt
BRIEF*.md
ANSWERS.md
REFERENCE.md
COMPLAINT*.md
_*.ps1
_*.txt

# --- Внутренние доки проекта: держим ТОЛЬКО локально (репозиторий публичный) ---
# Claude всё равно читает их с диска; на GitHub они не уходят.
/CLAUDE.md
/CHANGELOG.md
/docs/

# --- ОС/редакторы ---
Thumbs.db
.DS_Store
.idea/
.vscode/
